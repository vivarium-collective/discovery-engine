{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HypothesisProposal — a proposed competing hypothesis (DE-06)",
  "type": "object",
  "required": ["id", "statement", "mechanism", "predictions", "status", "provenance"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "pattern": "^hp:[0-9a-f]{12}$"},
    "statement": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["observable", "expected", "falsifier"],
        "properties": {
          "observable": {"type": "string", "minLength": 1},
          "expected": {"type": "object", "minProperties": 1},
          "falsifier": {"type": "string", "minLength": 1}
        }
      }
    },
    "status": {"enum": ["proposed", "accepted", "declined"]},
    "provenance": {
      "type": "object",
      "required": ["trigger"],
      "properties": {
        "trigger": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "by": {"type": "string"}
      }
    },
    "at": {"type": "string"}
  }
}
