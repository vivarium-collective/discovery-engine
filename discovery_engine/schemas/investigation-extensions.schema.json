{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "investigation.yaml closed-loop extension blocks",
  "type": "object",
  "properties": {
    "model_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "composite", "params", "parent_ids", "origin"],
        "properties": {
          "id": {"type": "string", "pattern": "^mv:[0-9a-f]{16}$"},
          "composite": {"type": "string"},
          "params": {"type": "object"},
          "parent_ids": {"type": "array", "items": {"type": "string", "pattern": "^mv:[0-9a-f]{16}$"}},
          "origin": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {"enum": ["authored", "seeded", "refined", "revision"]},
              "ref": {"type": "string"}
            }
          },
          "bound_to": {
            "type": "array",
            "items": {"type": "object", "required": ["study", "arm"],
                      "properties": {"study": {"type": "string"}, "arm": {"type": "string"}}}
          },
          "resolves": {"type": "boolean"}
        }
      }
    },
    "viz_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "study"],
        "properties": {
          "id": {"type": "string", "pattern": "^vp:"},
          "status": {"enum": ["proposed", "accepted", "rejected", "built"]},
          "study": {"type": "string"},
          "source": {"type": "object"},
          "suggested": {"type": "object"},
          "sharpens": {"type": "object"},
          "approval": {"type": "string"},
          "history": {"type": "array"},
          "built": {"type": ["object", "null"]},
          "derivable": {"type": "boolean"}
        }
      }
    },
    "revision_proposals": {"type": "array", "items": {"type": "object"}},
    "executive": {
      "type": "object",
      "properties": {
        "narrative_basis": {"type": "string"},
        "verdict_history": {"type": "array", "items": {"type": "object", "properties": {
          "from": {}, "to": {"type": "string"}, "rationale": {"type": "string", "minLength": 1},
          "by": {"type": "string"}, "at": {"type": "string"}},
          "required": ["to", "rationale"]}},
        "narrative_history": {"type": "array", "items": {"type": "object", "properties": {
          "basis": {"type": "string"}, "rationale": {"type": "string", "minLength": 1},
          "by": {"type": "string"}, "at": {"type": "string"}},
          "required": ["basis", "rationale"]}}
      }
    },
    "cycle_state": {
      "type": "object",
      "properties": {
        "freshness": {"type": "object"},
        "evaluation_snapshot": {"type": "object"},
        "model_versions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
